# URL base del backend Go (vacío para usar rutas relativas /api vía proxy de Vite o Vercel)
VITE_API_BASE_URL=

# Destino del proxy de desarrollo de Vite para /api (por defecto http://127.0.0.1:8080;
# en remoto p. ej. https://aire-trujillo.onrender.com para evitar bloqueo de cookies cross-site)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# API key de CARTO para tiles raster del mapa base (opcional si usas endpoint público)
VITE_CARTO_API_KEY=

# Plantillas opcionales de tiles CARTO/Mapbox compatibles ({z}/{x}/{y} y {api_key})
# VITE_CARTO_TILE_URL_LIGHT=https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}@2x.png
# VITE_CARTO_TILE_URL_DARK=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png
