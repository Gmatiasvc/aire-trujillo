# URL base del backend Go (vacío en desarrollo para usar el proxy de Vite hacia :8080)
VITE_API_BASE_URL=

# API key de CARTO para tiles raster del mapa base (opcional si usas endpoint público)
VITE_CARTO_API_KEY=

# Plantillas opcionales de tiles CARTO/Mapbox compatibles ({z}/{x}/{y} y {api_key})
# VITE_CARTO_TILE_URL_LIGHT=https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}@2x.png
# VITE_CARTO_TILE_URL_DARK=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png
